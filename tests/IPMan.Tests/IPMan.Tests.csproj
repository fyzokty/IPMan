<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>IPMan.Tests</RootNamespace>
    <AssemblyName>IPMan.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Required to reference the WPF application project for ViewModel tests. -->
    <UseWPF>true</UseWPF>
    <!--
      Behaviour-focused test names (Method_WhenCondition_ExpectedResult) are
      required by docs/07_Development/Sprint_04/04_TEST_REQUIREMENTS.md, so the
      underscore naming rule is relaxed for test code only.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IPMan.App\IPMan.App.csproj" />
    <ProjectReference Include="..\..\src\IPMan.Application\IPMan.Application.csproj" />
    <ProjectReference Include="..\..\src\IPMan.Domain\IPMan.Domain.csproj" />
    <ProjectReference Include="..\..\src\IPMan.Infrastructure\IPMan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
