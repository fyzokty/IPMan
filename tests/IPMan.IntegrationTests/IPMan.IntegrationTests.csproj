<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>IPMan.IntegrationTests</RootNamespace>
    <AssemblyName>IPMan.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Behaviour-focused test names follow the repository test convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IPMan.Application\IPMan.Application.csproj" />
    <ProjectReference Include="..\..\src\IPMan.Domain\IPMan.Domain.csproj" />
    <ProjectReference Include="..\..\src\IPMan.Infrastructure\IPMan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
