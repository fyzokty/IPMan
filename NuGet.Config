<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear /> discards machine- and user-level package sources so that restore
    depends only on what this file declares. Without it, restore results vary
    with whatever is configured on the developer's machine or the CI runner.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
