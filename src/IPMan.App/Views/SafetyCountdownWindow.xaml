<Window x:Class="IPMan.App.Views.SafetyCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:p="clr-namespace:IPMan.App.Presentation"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources><p:CountdownRingConverter x:Key="CountdownRing" /></Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Content="{x:Static res:Strings.SafeSwitchRevert}" Command="{Binding RevertCommand}" Margin="0,0,6,0"
                        Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Grid.Column="1" Content="{x:Static res:Strings.SafeSwitchKeep}" Command="{Binding KeepCommand}"
                        IsDefault="True" Margin="6,0,0,0" Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>
        </Border>
        <StackPanel Margin="28">
            <Grid Width="100" Height="100" Margin="0,0,0,24" HorizontalAlignment="Center"
                  AutomationProperties.Name="{x:Static res:Strings.SafeSwitchCountdownAccessibleName}">
                <Ellipse Width="84" Height="84" Stroke="{DynamicResource InfoBackgroundBrush}" StrokeThickness="6" />
                <Path Data="{Binding Progress, Converter={StaticResource CountdownRing}}" Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RemainingSeconds}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchSeconds}" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </DockPanel>
</Window>
