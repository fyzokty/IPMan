<Window x:Class="IPMan.App.Views.InternetLossConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,14" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="{x:Static res:Strings.SafeSwitchDoNotAskAgain}" IsChecked="{Binding DoNotAskAgain}"
                          VerticalAlignment="Center" Margin="0" />
                <Button Grid.Column="1" Content="{x:Static res:Strings.SafeSwitchCancel}" IsCancel="True"
                        Style="{StaticResource SecondaryActionButtonStyle}" Margin="8,0" />
                <Button Grid.Column="2" Content="{x:Static res:Strings.SafeSwitchGo}" IsDefault="True" Click="OnAccepted"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>
        </Border>
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchComputerAddress}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                        <TextBlock Text="{Binding OldAddress}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{x:Static res:Strings.SafeSwitchAddressArrow}" Margin="10,0" />
                        <TextBlock Text="{Binding NewAddress}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <Separator Margin="0,0,0,10" />
                    <DockPanel>
                        <TextBlock Text="{x:Static res:Strings.SafeSwitchConnection}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding ConnectionName}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right" Margin="12,0,0,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconStyle}" Foreground="{DynamicResource WarningBorderBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchInternetAdvisory}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Expander Header="{x:Static res:Strings.SafeSwitchTechnicalDetails}" IsExpanded="False"
                      Style="{StaticResource SafeSwitchDetailsExpanderStyle}">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchSubnetMask}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SubnetMask}" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,10" />
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchGateway}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding Gateway}" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,10" />
                    <TextBlock Text="{x:Static res:Strings.SafeSwitchDns}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding Dns}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </DockPanel>
</Window>
