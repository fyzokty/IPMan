<UserControl x:Class="IPMan.App.Views.AdapterDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:IPMan.App.Resources"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
             FontFamily="{DynamicResource BodyFont}" FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/Details.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="{x:Static res:Strings.DetailsBack}" Command="{Binding BackCommand}" Margin="0,0,16,0" />
            <TextBlock Grid.Column="1" Text="{Binding Adapter.DisplayName}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Border Grid.Column="2" Style="{StaticResource ConnectivityIndicatorStyle}" CornerRadius="16" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" />
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,16">
                <Border Style="{StaticResource ResultBannerStyle}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"
                        Visibility="{Binding HasActionStatus, Converter={StaticResource DetailsVisibility}}">
                    <TextBlock Text="{Binding Actions.StatusMessage}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource DetailsFailure}" Visibility="{Binding HasFailure, Converter={StaticResource DetailsVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.DetailsDismiss}" Command="{Binding DismissFailureCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding Failure.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Failure.Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Failure.NetworkState}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{x:Static res:Strings.DetailsRetry}" Command="{Binding RetryCommand}" Margin="0,0,8,0" />
                            <Button Content="{x:Static res:Strings.DetailsTechnical}" Command="{Binding ToggleTechnicalDetailsCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding Failure.TechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0"
                                 Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource DetailsVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.DetailsCurrentSettings}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource DetailsModeSelector}" AutomationProperties.Name="{x:Static res:Strings.DetailsAddressMode}">
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                                    <RadioButton Content="{x:Static res:Strings.DetailsAutomatic}" GroupName="DetailsMode" IsChecked="{Binding IsAutomatic}" Style="{StaticResource ViewModeSegmentStyle}" />
                                    <RadioButton Content="{x:Static res:Strings.DetailsStatic}" GroupName="DetailsMode" IsChecked="{Binding IsStatic}" Style="{StaticResource ViewModeSegmentStyle}" />
                                </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsModeChanged, Converter={StaticResource DetailsVisibility}}">
                                    <TextBlock Text="{x:Static res:Strings.DetailsChanged}" Style="{StaticResource DetailsChangedLabel}" />
                                    <TextBlock Text="{Binding ModeCurrentText}" Margin="8,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BasicFields}" />
                        <Expander Style="{StaticResource DetailsAdvancedExpander}" Header="{x:Static res:Strings.DetailsAdvanced}" Margin="0,4,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{x:Static res:Strings.DetailsDns}" Style="{StaticResource SectionHeaderStyle}" />
                                <ItemsControl ItemsSource="{Binding DnsFields}" />
                                <TextBlock Text="{x:Static res:Strings.DetailsConnectionInfo}" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Static res:Strings.DetailsHardware}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Adapter.Details.Description}" TextWrapping="Wrap" Margin="0,8" />
                                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.DetailsMac}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Adapter.Details.MacAddress}" FontFamily="{StaticResource MonoFont}" Margin="0,8" />
                                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.DetailsSpeed}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Adapter.Details.LinkSpeed}" Margin="0,8" />
                                </Grid>
                                <WrapPanel>
                                    <Button Content="{x:Static res:Strings.DetailsCopy}" Command="{Binding Actions.CopyNetworkInfoCommand}" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.DetailsPing}" Command="{Binding Actions.PingGatewayCommand}" ToolTip="{Binding Actions.PingGatewayDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.DetailsFlush}" Command="{Binding Actions.FlushDnsCommand}" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.DetailsRenew}" Command="{Binding Actions.RenewIpCommand}" ToolTip="{Binding Actions.RenewIpDisabledReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.DetailsRestore}" Command="{Binding Actions.RestoreLastCommand}" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource DetailsFooter}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ChangeSummary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Static res:Strings.DetailsSave}" Command="{Binding SaveAsSettingCommand}" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" Margin="12,0" />
                <Button Grid.Column="2" Content="{x:Static res:Strings.DetailsCancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{x:Static res:Strings.DetailsApply}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
