<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.MainWindow"
        Title="{Binding ApplicationName}"
        Width="1000"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:vm="clr-namespace:IPMan.App.ViewModels"
        xmlns:views="clr-namespace:IPMan.App.Views"
        xmlns:motion="clr-namespace:IPMan.App.Presentation"
        motion:FluentMotion.Entrance="True"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="DraftIpv4DifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="motion:FluentMotion.IsInvalid" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ipv4AddressError.Length}" Value="0">
                    <Setter Property="motion:FluentMotion.IsInvalid" Value="False" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsIpv4AddressDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding Ipv4AddressError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftSubnetDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="motion:FluentMotion.IsInvalid" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubnetMaskError.Length}" Value="0">
                    <Setter Property="motion:FluentMotion.IsInvalid" Value="False" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSubnetMaskDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding SubnetMaskError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftGatewayDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="motion:FluentMotion.IsInvalid" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GatewayError.Length}" Value="0">
                    <Setter Property="motion:FluentMotion.IsInvalid" Value="False" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGatewayDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding GatewayError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftPrimaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="motion:FluentMotion.IsInvalid" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PrimaryDnsError.Length}" Value="0">
                    <Setter Property="motion:FluentMotion.IsInvalid" Value="False" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPrimaryDnsDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding PrimaryDnsError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftSecondaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="motion:FluentMotion.IsInvalid" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SecondaryDnsError.Length}" Value="0">
                    <Setter Property="motion:FluentMotion.IsInvalid" Value="False" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSecondaryDnsDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding SecondaryDnsError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="AdapterDetailsTemplate" DataType="{x:Type vm:AdapterViewModel}">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Current configuration (read-only) -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                        <StackPanel DataContext="{Binding Details}">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource IconStyle}"
                                           Text="&#xE9D9;"
                                           Margin="0,0,8,0"
                                           DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.CurrentConfigurationHeader}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConnectionState}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConnectionState}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdapterName}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldDescription}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Description}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldMacAddress}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding MacAddress}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConfigurationMode}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConfigurationMode}" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldIpv4Address}" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding Ipv4Address}" />
                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSubnetMask}" />
                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding SubnetMask}" />
                                <TextBlock Grid.Row="7"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldGateway}" />
                                <TextBlock Grid.Row="7"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding Gateway}" />
                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldPrimaryDns}" />
                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding PrimaryDns}" />
                                <TextBlock Grid.Row="9"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSecondaryDns}" />
                                <TextBlock Grid.Row="9"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding SecondaryDns}" />
                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldLinkSpeed}" />
                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding LinkSpeed}" />
                                <TextBlock Grid.Row="11"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdditionalIpv4Addresses}"
                                           Visibility="{Binding HasAdditionalIpv4Addresses, Converter={StaticResource BooleanToVisibility}}" />
                                <ItemsControl Grid.Row="11"
                                              Grid.Column="1"
                                              Margin="0,0,0,6"
                                              ItemsSource="{Binding AdditionalIpv4AddressList}"
                                              Visibility="{Binding HasAdditionalIpv4Addresses, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource MonoValueStyle}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        motion:CopyFeedback.Result="{Binding SelectedItem.CopySucceeded, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.Ipv4Address}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        motion:CopyFeedback.Result="{Binding SelectedItem.CopySucceeded, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.SubnetMask}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        motion:CopyFeedback.Result="{Binding SelectedItem.CopySucceeded, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.Gateway}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldGateway}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        motion:CopyFeedback.Result="{Binding SelectedItem.CopySucceeded, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.PrimaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="8"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        motion:CopyFeedback.Result="{Binding SelectedItem.CopySucceeded, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.SecondaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="9"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- Configuration draft and network actions. -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                        <Grid>
                        <StackPanel DataContext="{Binding Draft}">
                            <DockPanel Margin="0,0,0,12">
                                <Button Command="{Binding GetCurrentValuesCommand}"
                                        Content="{x:Static res:Strings.CommandGetCurrentValues}"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Padding="4,4"
                                        Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Style="{StaticResource IconStyle}"
                                           Text="&#xE713;"
                                           Margin="0,0,8,0"
                                           DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.DraftConfigurationHeader}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Padding="8,6" Margin="0,0,0,10"
                                    Background="{DynamicResource InfoBackgroundBrush}"
                                    BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfileGuidance}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProfileGuidance}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xE946;"
                                               Foreground="{DynamicResource InfoBorderBrush}"
                                               VerticalAlignment="Top" Margin="0,1,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProfileGuidance}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0">
                                    <Grid Margin="0,0,0,4" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldIpv4Address}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DraftDifferentHint}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBorderBrush}"
                                                   ToolTip="{Binding SelectedItem.Details.Ipv4Address, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsIpv4AddressDifferentFromWindows}" Value="True" />
                                                                <Condition Binding="{Binding Ipv4AddressError.Length}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldErrorTextStyle}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite" Text="{Binding Ipv4AddressError}" />
                                    </Grid>
                                    <Grid>
                                        <TextBox x:Name="Ipv4AddressBox" Style="{StaticResource DraftIpv4DifferentStyle}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}"
                                                 Text="{Binding Ipv4Address, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource CopyButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                Command="{Binding CopyFieldCommand}" motion:CopyFeedback.Result="{Binding CopySucceeded}"
                                                CommandParameter="{x:Static vm:DraftField.Ipv4Address}" Content="{x:Static res:Strings.CommandCopy}"
                                                AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,4" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldSubnetMask}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DraftDifferentHint}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBorderBrush}"
                                                   ToolTip="{Binding SelectedItem.Details.SubnetMask, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSubnetMaskDifferentFromWindows}" Value="True" />
                                                                <Condition Binding="{Binding SubnetMaskError.Length}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldErrorTextStyle}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite" Text="{Binding SubnetMaskError}" />
                                    </Grid>
                                    <Grid>
                                        <TextBox Style="{StaticResource DraftSubnetDifferentStyle}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}"
                                                 Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource CopyButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                Command="{Binding CopyFieldCommand}" motion:CopyFeedback.Result="{Binding CopySucceeded}"
                                                CommandParameter="{x:Static vm:DraftField.SubnetMask}" Content="{x:Static res:Strings.CommandCopy}"
                                                AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,4" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldGateway}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DraftDifferentHint}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBorderBrush}"
                                                   ToolTip="{Binding SelectedItem.Details.Gateway, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsGatewayDifferentFromWindows}" Value="True" />
                                                                <Condition Binding="{Binding GatewayError.Length}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldErrorTextStyle}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite" Text="{Binding GatewayError}" />
                                    </Grid>
                                    <Grid>
                                        <TextBox Style="{StaticResource DraftGatewayDifferentStyle}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldGateway}"
                                                 Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource CopyButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                Command="{Binding CopyFieldCommand}" motion:CopyFeedback.Result="{Binding CopySucceeded}"
                                                CommandParameter="{x:Static vm:DraftField.Gateway}" Content="{x:Static res:Strings.CommandCopy}"
                                                AutomationProperties.Name="{x:Static res:Strings.FieldGateway}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,4" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldPrimaryDns}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DraftDifferentHint}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBorderBrush}"
                                                   ToolTip="{Binding SelectedItem.Details.PrimaryDns, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsPrimaryDnsDifferentFromWindows}" Value="True" />
                                                                <Condition Binding="{Binding PrimaryDnsError.Length}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldErrorTextStyle}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite" Text="{Binding PrimaryDnsError}" />
                                    </Grid>
                                    <Grid>
                                        <TextBox Style="{StaticResource DraftPrimaryDnsDifferentStyle}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}"
                                                 Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource CopyButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                Command="{Binding CopyFieldCommand}" motion:CopyFeedback.Result="{Binding CopySucceeded}"
                                                CommandParameter="{x:Static vm:DraftField.PrimaryDns}" Content="{x:Static res:Strings.CommandCopy}"
                                                AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,4" Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static res:Strings.FieldSecondaryDns}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DraftDifferentHint}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBorderBrush}"
                                                   ToolTip="{Binding SelectedItem.Details.SecondaryDns, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSecondaryDnsDifferentFromWindows}" Value="True" />
                                                                <Condition Binding="{Binding SecondaryDnsError.Length}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldErrorTextStyle}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite" Text="{Binding SecondaryDnsError}" />
                                    </Grid>
                                    <Grid>
                                        <TextBox Style="{StaticResource DraftSecondaryDnsDifferentStyle}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}"
                                                 Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource CopyButtonStyle}" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                Command="{Binding CopyFieldCommand}" motion:CopyFeedback.Result="{Binding CopySucceeded}"
                                                CommandParameter="{x:Static vm:DraftField.SecondaryDns}" Content="{x:Static res:Strings.CommandCopy}"
                                                AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyStaticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandApply}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyDhcpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandUseDhcp}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.RestoreLastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandRestoreLastCompact}"
                                        AutomationProperties.Name="{x:Static res:Strings.CommandRestoreLast}"
                                        ToolTip="{x:Static res:Strings.CommandRestoreLast}" />
                            </WrapPanel>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,8" />
                            <TextBlock Text="{x:Static res:Strings.QuickActionsHeader}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.CopyNetworkInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        motion:CopyFeedback.IsEnabled="True"
                                        motion:CopyFeedback.Result="{Binding DataContext.Actions.StatusSeverity, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandCopyNetworkInfo}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.PingGatewayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{Binding DataContext.Actions.PingGatewayDisabledReason, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandPingGateway}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.FlushDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandFlushDnsCompact}"
                                        AutomationProperties.Name="{x:Static res:Strings.CommandFlushDns}"
                                        ToolTip="{x:Static res:Strings.CommandFlushDns}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.RenewIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{Binding DataContext.Actions.RenewIpDisabledReason, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandRenewIp}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                            </UniformGrid>
                        </StackPanel>
                        <ProgressBar Height="3" VerticalAlignment="Top" Margin="-16,-16,-16,0"
                                     Visibility="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"
                                     IsIndeterminate="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingCardTemplate">
            <Border Style="{StaticResource SettingCardStyle}" Margin="6" Height="168">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{Binding FavoriteGlyph}" Padding="6,2" VerticalAlignment="Top" Height="32" Margin="0,0,4,0"
                    Command="{Binding Owner.ProfilePanel.ToggleFavoriteCommand}" CommandParameter="{Binding StoredSetting}"
                    AutomationProperties.Name="{x:Static res:Strings.FavoriteSetting}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}" /><Button Content="⋯" Padding="6,2" VerticalAlignment="Top" Height="32" Click="OnSettingMenuClicked" AutomationProperties.Name="{x:Static res:Strings.SettingMenu}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static res:Strings.EditSetting}" Command="{Binding Owner.EditSettingCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandDuplicateProfile}" Command="{Binding Owner.ProfilePanel.DuplicateCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandRenameProfile}" Command="{Binding Owner.ProfilePanel.RenameCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandExportProfile}" Command="{Binding Owner.ProfilePanel.ExportCommand}" CommandParameter="{Binding StoredSetting}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.CommandDeleteProfile}" Command="{Binding Owner.ProfilePanel.DeleteCommand}" CommandParameter="{Binding StoredSetting}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button></StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Border Style="{StaticResource SettingBadgeStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding Badge}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                    <Button Grid.Row="2" Content="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SettingRowTemplate">
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,4" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding FavoriteGlyph}" Padding="6,2" VerticalAlignment="Top" Height="32" Margin="0,0,4,0"
                    Command="{Binding Owner.ProfilePanel.ToggleFavoriteCommand}" CommandParameter="{Binding StoredSetting}"
                    AutomationProperties.Name="{x:Static res:Strings.FavoriteSetting}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="8,0" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                        <Border Style="{StaticResource SettingBadgeStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.AutomaticRecommended}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="3" Content="{Binding ListSwitchLabel}" Command="{Binding SwitchCommand}" Margin="8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Border Grid.Column="3" Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="12" Padding="10,4" Margin="8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.SettingInUse}" Foreground="{DynamicResource ConnectedBrush}" />
                    </Border>
                    <StackPanel Grid.Column="4"><Button Content="⋯" Padding="6,2" VerticalAlignment="Top" Height="32" Click="OnSettingMenuClicked" AutomationProperties.Name="{x:Static res:Strings.SettingMenu}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static res:Strings.EditSetting}" Command="{Binding Owner.EditSettingCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandDuplicateProfile}" Command="{Binding Owner.ProfilePanel.DuplicateCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandRenameProfile}" Command="{Binding Owner.ProfilePanel.RenameCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandExportProfile}" Command="{Binding Owner.ProfilePanel.ExportCommand}" CommandParameter="{Binding StoredSetting}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.CommandDeleteProfile}" Command="{Binding Owner.ProfilePanel.DeleteCommand}" CommandParameter="{Binding StoredSetting}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileEditorViewModel}"><views:ProfileEditorView /></DataTemplate>
    </Window.Resources>
    <DockPanel LastChildFill="True" Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.ConnectionSelectorLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                <ComboBox x:Name="ConnectionSelector" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                          IsEnabled="{Binding IsConnectionSelectionEnabled}" MinWidth="300" MaxWidth="540"
                          AutomationProperties.Name="{x:Static res:Strings.ConnectionSelectorLabel}">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Snapshot.Description}" AutomationProperties.Name="{Binding AccessibleDescription}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="HistoryButton" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="{x:Static res:Strings.NotificationHistory}" ToolTip="{x:Static res:Strings.NotificationHistory}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xEA8F;" />
                </Button>
                <Button Click="OnSettingsClicked" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{x:Static res:Strings.SettingsTitle}" ToolTip="{x:Static res:Strings.SettingsTitle}">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xE713;" />
                </Button>
                    <Popup motion:FluentMotion.Popup="True" AllowsTransparency="True" IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=HistoryButton}"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           StaysOpen="False">
                        <Border Width="410"
                                MaxHeight="360"
                                Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Content="{x:Static res:Strings.NotificationHistoryClear}"
                                        Command="{Binding ClearHistoryCommand}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.NotificationHistory}" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{x:Static res:Strings.NotificationHistoryEmpty}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationHistory.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox BorderThickness="0"
                                         Background="{DynamicResource TransparentBrush}"
                                         ItemsSource="{Binding NotificationHistory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ConnectedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:t}}" />
                                                <Run Text="{x:Static res:Strings.ProfileProblemSeparator}" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>

            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding SettingsWarningVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding SettingsWarningText}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding HasRefreshError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding RefreshErrorText}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
        </StackPanel>
        <Grid>
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" /><TextBlock Text="{x:Static res:Strings.LoadingAdapters}" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="{x:Static res:Strings.EmptyStateTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:Strings.EmptyStateDescription}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <Grid Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibility}}">
                <Grid Visibility="{Binding IsHomeVisible, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="ConnectionStatusCard" Margin="0,0,0,12">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsCableDisconnected}" Value="True"><Setter Property="Background" Value="{DynamicResource DisconnectedBackgroundBrush}" /></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ConnectivityIndicatorStyle}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconStyle}" Text="{Binding ConnectivityGlyph}" HorizontalAlignment="Center" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusHeadline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="{x:Static res:Strings.SwitchToWireless}" Command="{Binding SwitchToWirelessCommand}" IsEnabled="{Binding IsConnectionSelectionEnabled}"
                                        Visibility="{Binding HasWirelessShortcut, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
                                <Button Content="{x:Static res:Strings.DetailsAndManualSettings}" Command="{Binding OpenDetailsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ResultBannerStyle}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"
                            Visibility="{Binding Actions.HasStatusMessage, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButtonStyle}" Command="{Binding Actions.ClearStatusCommand}" AutomationProperties.Name="{x:Static res:Strings.CommandClearStatus}" />
                            <TextBlock Text="{Binding Actions.StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,8,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SettingsQuestion}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="8,0,12,0">
                            <TextBox Text="{Binding ProfilePanel.SearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" AutomationProperties.Name="{x:Static res:Strings.ProfileSearchPlaceholder}" />
                            <TextBlock Text="{x:Static res:Strings.ProfileSearchPlaceholder}" Margin="10,0" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ProfilePanel.SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Column="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{x:Static res:Strings.ViewModeCard}" IsChecked="{Binding IsCardView, Mode=OneWay}" Command="{Binding ChooseCardViewCommand}" GroupName="ViewMode" Style="{StaticResource ViewModeSegmentStyle}" />
                                <RadioButton Content="{x:Static res:Strings.ViewModeList}" IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding ChooseListViewCommand}" GroupName="ViewMode" Style="{StaticResource ViewModeSegmentStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SettingCardTemplate}" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><motion:ResponsiveCardPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibility}}">
                                <ContentControl Content="{Binding Settings[0]}" ContentTemplate="{StaticResource SettingRowTemplate}" />
                                <ItemsControl ItemsSource="{Binding SettingGroups}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,12,0,8" />
                                            <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SettingRowTemplate}" /></StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <WrapPanel Margin="6,12,0,12">
                                <Button Content="{x:Static res:Strings.NewSetting}" Command="{Binding NewSettingCommand}" Margin="0,0,8,0" />
                                <Button Content="{x:Static res:Strings.CommandImportProfile}" Command="{Binding ProfilePanel.ImportCommand}" />
                            </WrapPanel>
                            <StackPanel DataContext="{Binding ProfilePanel}">
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
                                <Expander Style="{StaticResource ProfileProblemsExpanderStyle}" Header="{Binding ProblemsHeader}" Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Problems}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="{x:Static res:Strings.ProfileProblemSeparator}" /><Run Text="{Binding Reason, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <DockPanel Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="{x:Static res:Strings.GoBack}" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding ApplicationState}" Margin="0,0,16,0" /><TextBlock Text="{Binding SelectedAdapterState}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding LastRefresh}" Margin="0,0,16,0" /><TextBlock Text="{Binding AdministratorState}" Margin="0,0,16,0" /><TextBlock Text="{Binding Version}" />
                        </WrapPanel>
                        <Border Style="{StaticResource ResultBannerStyle}" Visibility="{Binding Actions.HasStatusMessage, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding Actions.StatusMessage}" TextWrapping="Wrap" /></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0" DataContext="{Binding ProfilePanel}">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="{x:Static res:Strings.ProfileNameLabel}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                        <TextBox Width="180" Height="32" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}" /></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="{x:Static res:Strings.ProfileDescriptionLabel}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                                        <TextBox Width="220" Height="32" Text="{Binding NewProfileDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:Strings.ProfileDescriptionLabel}" /></StackPanel>
                                    <CheckBox Content="{x:Static res:Strings.ProfileUseDhcpLabel}" IsChecked="{Binding NewProfileUsesDhcp}" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                                    <Button Content="{x:Static res:Strings.CommandSaveProfile}" Command="{Binding SaveCommand}" VerticalAlignment="Bottom" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ContentControl Content="{Binding SelectedAdapter}" ContentTemplate="{StaticResource AdapterDetailsTemplate}" />
                </DockPanel>
                <ContentControl Content="{Binding ProfileEditor}" Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
