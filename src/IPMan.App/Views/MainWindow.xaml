<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.MainWindow"
        Title="{Binding ApplicationName}"
        Width="1000"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:vm="clr-namespace:IPMan.App.ViewModels"
        xmlns:views="clr-namespace:IPMan.App.Views"
        xmlns:motion="clr-namespace:IPMan.App.Presentation"
        motion:FluentMotion.Entrance="True"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <DataTemplate x:Key="SettingCardTemplate">
            <Border Style="{StaticResource SettingCardStyle}" Margin="6" Height="168">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{Binding FavoriteGlyph}" Style="{StaticResource SquareButtonStyle}" VerticalAlignment="Top" Margin="0,0,4,0"
                    Command="{Binding Owner.ProfilePanel.ToggleFavoriteCommand}" CommandParameter="{Binding StoredSetting}"
                    AutomationProperties.Name="{x:Static res:Strings.FavoriteSetting}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}" /><Button Content="⋯" Style="{StaticResource SquareButtonStyle}" VerticalAlignment="Top" Click="OnSettingMenuClicked" AutomationProperties.Name="{x:Static res:Strings.SettingMenu}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static res:Strings.EditSetting}" Command="{Binding Owner.EditSettingCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandDuplicateProfile}" Command="{Binding Owner.ProfilePanel.DuplicateCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandRenameProfile}" Command="{Binding Owner.ProfilePanel.RenameCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandExportProfile}" Command="{Binding Owner.ProfilePanel.ExportCommand}" CommandParameter="{Binding StoredSetting}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.CommandDeleteProfile}" Command="{Binding Owner.ProfilePanel.DeleteCommand}" CommandParameter="{Binding StoredSetting}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button></StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Border Style="{StaticResource SettingBadgeStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="{Binding Badge}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                    <Button Grid.Row="2" Content="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SettingRowTemplate">
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,0,4" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource SquareButtonStyle}" Margin="0,0,4,0"
                    Command="{Binding Owner.ProfilePanel.ToggleFavoriteCommand}" CommandParameter="{Binding StoredSetting}"
                    AutomationProperties.Name="{x:Static res:Strings.FavoriteSetting}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="8,0" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                        <Border Style="{StaticResource SettingBadgeStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.AutomaticRecommended}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="3" Content="{Binding ListSwitchLabel}" Command="{Binding SwitchCommand}" Margin="8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Border Grid.Column="3" Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="12" Padding="10,4" Margin="8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.SettingInUse}" Foreground="{DynamicResource ConnectedBrush}" />
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><Button Content="⋯" Style="{StaticResource SquareButtonStyle}" Click="OnSettingMenuClicked" AutomationProperties.Name="{x:Static res:Strings.SettingMenu}"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{x:Static res:Strings.EditSetting}" Command="{Binding Owner.EditSettingCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandDuplicateProfile}" Command="{Binding Owner.ProfilePanel.DuplicateCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandRenameProfile}" Command="{Binding Owner.ProfilePanel.RenameCommand}" CommandParameter="{Binding StoredSetting}" />
                        <MenuItem Header="{x:Static res:Strings.CommandExportProfile}" Command="{Binding Owner.ProfilePanel.ExportCommand}" CommandParameter="{Binding StoredSetting}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Strings.CommandDeleteProfile}" Command="{Binding Owner.ProfilePanel.DeleteCommand}" CommandParameter="{Binding StoredSetting}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdapterDetailsPageViewModel}"><views:AdapterDetailsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileEditorViewModel}"><views:ProfileEditorView /></DataTemplate>
    </Window.Resources>
    <DockPanel LastChildFill="True" Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.ConnectionSelectorLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                <ComboBox x:Name="ConnectionSelector" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                          IsEnabled="{Binding IsConnectionSelectionEnabled}" MinWidth="300" MaxWidth="540"
                          AutomationProperties.Name="{x:Static res:Strings.ConnectionSelectorLabel}">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Snapshot.Description}" AutomationProperties.Name="{Binding AccessibleDescription}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="HistoryButton" Command="{Binding ToggleHistoryCommand}" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="{x:Static res:Strings.NotificationHistory}" ToolTip="{x:Static res:Strings.NotificationHistory}" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xEA8F;" />
                </Button>
                <Button Click="OnSettingsClicked" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{x:Static res:Strings.SettingsTitle}" ToolTip="{x:Static res:Strings.SettingsTitle}">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xE713;" />
                </Button>
                    <Popup motion:FluentMotion.Popup="True" AllowsTransparency="True" IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=HistoryButton}"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           StaysOpen="False">
                        <Border Width="410"
                                MaxHeight="360"
                                Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Content="{x:Static res:Strings.NotificationHistoryClear}"
                                        Command="{Binding ClearHistoryCommand}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.NotificationHistory}" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{x:Static res:Strings.NotificationHistoryEmpty}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationHistory.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox BorderThickness="0"
                                         Background="{DynamicResource TransparentBrush}"
                                         ItemsSource="{Binding NotificationHistory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ConnectedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:t}}" />
                                                <Run Text="{x:Static res:Strings.ProfileProblemSeparator}" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>

            </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding SettingsWarningVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding SettingsWarningText}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding HasRefreshError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding RefreshErrorText}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
        </StackPanel>
        <Grid>
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" /><TextBlock Text="{x:Static res:Strings.LoadingAdapters}" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="{x:Static res:Strings.EmptyStateTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:Strings.EmptyStateDescription}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <Grid Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibility}}">
                <Grid Visibility="{Binding IsHomeVisible, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="ConnectionStatusCard" Margin="0,0,0,12">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsCableDisconnected}" Value="True"><Setter Property="Background" Value="{DynamicResource DisconnectedBackgroundBrush}" /></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ConnectivityIndicatorStyle}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconStyle}" Text="{Binding ConnectivityGlyph}" HorizontalAlignment="Center" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusHeadline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="{x:Static res:Strings.SwitchToWireless}" Command="{Binding SwitchToWirelessCommand}" IsEnabled="{Binding IsConnectionSelectionEnabled}"
                                        Visibility="{Binding HasWirelessShortcut, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
                                <Button Content="{x:Static res:Strings.DetailsAndManualSettings}" Command="{Binding OpenDetailsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource ResultBannerStyle}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"
                            Visibility="{Binding Actions.HasStatusMessage, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButtonStyle}" Command="{Binding Actions.ClearStatusCommand}" AutomationProperties.Name="{x:Static res:Strings.CommandClearStatus}" />
                            <TextBlock Text="{Binding Actions.StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,8,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.SettingsQuestion}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="8,0,12,0">
                            <TextBox Text="{Binding ProfilePanel.SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:Strings.ProfileSearchPlaceholder}" />
                            <TextBlock Text="{x:Static res:Strings.ProfileSearchPlaceholder}" Margin="10,0" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ProfilePanel.SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Column="2" Style="{StaticResource SegmentedControlStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{x:Static res:Strings.ViewModeCard}" IsChecked="{Binding IsCardView, Mode=OneWay}" Command="{Binding ChooseCardViewCommand}" GroupName="ViewMode" Style="{StaticResource ViewModeSegmentStyle}" />
                                <RadioButton Content="{x:Static res:Strings.ViewModeList}" IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding ChooseListViewCommand}" GroupName="ViewMode" Style="{StaticResource ViewModeSegmentStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SettingCardTemplate}" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><motion:ResponsiveCardPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibility}}">
                                <ContentControl Content="{Binding Settings[0]}" ContentTemplate="{StaticResource SettingRowTemplate}" />
                                <ItemsControl ItemsSource="{Binding SettingGroups}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,12,0,8" />
                                            <ItemsControl ItemsSource="{Binding Settings}" ItemTemplate="{StaticResource SettingRowTemplate}" /></StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <WrapPanel Margin="6,12,0,12">
                                <Button Content="{x:Static res:Strings.NewSetting}" Command="{Binding NewSettingCommand}" Margin="0,0,8,0" />
                                <Button Content="{x:Static res:Strings.CommandImportProfile}" Command="{Binding ProfilePanel.ImportCommand}" />
                            </WrapPanel>
                            <StackPanel DataContext="{Binding ProfilePanel}">
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" />
                                <Expander Style="{StaticResource ProfileProblemsExpanderStyle}" Header="{Binding ProblemsHeader}" Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Problems}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="{x:Static res:Strings.ProfileProblemSeparator}" /><Run Text="{Binding Reason, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ContentControl Content="{Binding DetailsPage}" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibility}}" />
                <ContentControl Content="{Binding ProfileEditor}" Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
