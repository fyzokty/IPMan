<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.MainWindow"
        Title="{Binding ApplicationName}"
        Width="1100"
        Height="700"
        MinWidth="1100"
        MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:vm="clr-namespace:IPMan.App.ViewModels"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <!-- Tab header: name plus a shape-based connection marker, never colour alone. -->
        <DataTemplate x:Key="AdapterTabHeaderTemplate" DataType="{x:Type vm:AdapterViewModel}">
            <StackPanel Orientation="Horizontal"
                        AutomationProperties.Name="{Binding AccessibleDescription}"
                        ToolTip="{Binding AccessibleDescription}">
                <TextBlock Text="{Binding ConnectionMarker}" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource DisconnectedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ConnectedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayName}"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="DraftIpv4DifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ipv4AddressError.Length}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsIpv4AddressDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding Ipv4AddressError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftSubnetDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubnetMaskError.Length}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSubnetMaskDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding SubnetMaskError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftGatewayDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GatewayError.Length}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGatewayDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding GatewayError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftPrimaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PrimaryDnsError.Length}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPrimaryDnsDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding PrimaryDnsError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DraftSecondaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SecondaryDnsError.Length}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSecondaryDnsDifferentFromWindows}" Value="True" />
                        <Condition Binding="{Binding SecondaryDnsError.Length}" Value="0" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Tab content: current configuration on the left, editable draft on the right. -->
        <DataTemplate x:Key="AdapterTabContentTemplate" DataType="{x:Type vm:AdapterViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Current configuration (read-only) -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                        <StackPanel DataContext="{Binding Details}">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource IconStyle}"
                                           Text="&#xE9D9;"
                                           Margin="0,0,8,12"
                                           DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.CurrentConfigurationHeader}" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConnectionState}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConnectionState}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdapterName}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldDescription}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Description}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldMacAddress}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding MacAddress}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConfigurationMode}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConfigurationMode}" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldIpv4Address}" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding Ipv4Address}" />
                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSubnetMask}" />
                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding SubnetMask}" />
                                <TextBlock Grid.Row="7"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldGateway}" />
                                <TextBlock Grid.Row="7"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding Gateway}" />
                                <TextBlock Grid.Row="8"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldPrimaryDns}" />
                                <TextBlock Grid.Row="8"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding PrimaryDns}" />
                                <TextBlock Grid.Row="9"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSecondaryDns}" />
                                <TextBlock Grid.Row="9"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding SecondaryDns}" />
                                <TextBlock Grid.Row="10"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldLinkSpeed}" />
                                <TextBlock Grid.Row="10"
                                           Grid.Column="1"
                                           Style="{StaticResource MonoValueStyle}"
                                           Text="{Binding LinkSpeed}" />
                                <TextBlock Grid.Row="11"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdditionalIpv4Addresses}"
                                           Visibility="{Binding HasAdditionalIpv4Addresses, Converter={StaticResource BooleanToVisibility}}" />
                                <ItemsControl Grid.Row="11"
                                              Grid.Column="1"
                                              Margin="0,0,0,6"
                                              ItemsSource="{Binding AdditionalIpv4AddressList}"
                                              Visibility="{Binding HasAdditionalIpv4Addresses, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource MonoValueStyle}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.Ipv4Address}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.SubnetMask}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.Gateway}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldGateway}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.PrimaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="8"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}" />
                                <Button Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding SelectedItem.CopyCurrentFieldCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{x:Static vm:DraftField.SecondaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        Grid.Row="9"
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- Configuration draft (edit only; nothing is written to Windows) -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                        <StackPanel DataContext="{Binding Draft}">
                            <DockPanel Margin="0,0,0,12">
                                <Button Command="{Binding GetCurrentValuesCommand}"
                                        Content="{x:Static res:Strings.CommandGetCurrentValues}"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Padding="4,4"
                                        Margin="8,0,0,8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Style="{StaticResource IconStyle}"
                                           Text="&#xE713;"
                                           Margin="0,0,8,12"
                                           DockPanel.Dock="Left" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.DraftConfigurationHeader}" />
                            </DockPanel>
                            <TextBlock Margin="0,0,0,14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{x:Static res:Strings.DraftConfigurationHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding ProfileGuidance}"
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                                    <TextBox x:Name="Ipv4AddressBox"
                                             Style="{StaticResource DraftIpv4DifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}"
                                             Text="{Binding Ipv4Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding Ipv4AddressError}" />
                                </StackPanel>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.Ipv4Address}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}" />
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,4">
                                    <TextBox Style="{StaticResource DraftSubnetDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}"
                                             Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding SubnetMaskError}" />
                                </StackPanel>
                                <Button Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.SubnetMask}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}" />
                                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,8,4">
                                    <TextBox Style="{StaticResource DraftGatewayDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldGateway}"
                                             Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding GatewayError}" />
                                </StackPanel>
                                <Button Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.Gateway}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldGateway}" />
                                <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,8,4">
                                    <TextBox Style="{StaticResource DraftPrimaryDnsDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}"
                                             Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding PrimaryDnsError}" />
                                </StackPanel>
                                <Button Grid.Row="7"
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.PrimaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}" />
                                <StackPanel Grid.Row="9" Grid.Column="0" Margin="0,0,8,4">
                                    <TextBox Style="{StaticResource DraftSecondaryDnsDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}"
                                             Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding SecondaryDnsError}" />
                                </StackPanel>
                                <Button Grid.Row="9"
                                        Grid.Column="1"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.SecondaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}" />
                                <DockPanel Grid.Row="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Static res:Strings.DraftDifferentHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBorderBrush}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding IsIpv4AddressDifferentFromWindows, Converter={StaticResource BooleanToVisibility}}"
                                               ToolTip="{Binding SelectedItem.Details.Ipv4Address, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{x:Static res:Strings.FieldIpv4Address}"
                                               Margin="0,8,8,4"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Static res:Strings.DraftDifferentHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBorderBrush}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding IsSubnetMaskDifferentFromWindows, Converter={StaticResource BooleanToVisibility}}"
                                               ToolTip="{Binding SelectedItem.Details.SubnetMask, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{x:Static res:Strings.FieldSubnetMask}"
                                               Margin="0,8,8,4"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <DockPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Static res:Strings.DraftDifferentHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBorderBrush}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding IsGatewayDifferentFromWindows, Converter={StaticResource BooleanToVisibility}}"
                                               ToolTip="{Binding SelectedItem.Details.Gateway, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{x:Static res:Strings.FieldGateway}"
                                               Margin="0,8,8,4"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <DockPanel Grid.Row="6" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Static res:Strings.DraftDifferentHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBorderBrush}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding IsPrimaryDnsDifferentFromWindows, Converter={StaticResource BooleanToVisibility}}"
                                               ToolTip="{Binding SelectedItem.Details.PrimaryDns, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{x:Static res:Strings.FieldPrimaryDns}"
                                               Margin="0,8,8,4"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                                <DockPanel Grid.Row="8" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Static res:Strings.DraftDifferentHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WarningBorderBrush}"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding IsSecondaryDnsDifferentFromWindows, Converter={StaticResource BooleanToVisibility}}"
                                               ToolTip="{Binding SelectedItem.Details.SecondaryDns, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{x:Static res:Strings.FieldSecondaryDns}"
                                               Margin="0,8,8,4"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </DockPanel>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyStaticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandApply}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyDhcpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandUseDhcp}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.RestoreLastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandRestoreLast}" />
                            </WrapPanel>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,8" />
                            <TextBlock Text="{x:Static res:Strings.QuickActionsHeader}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.CopyNetworkInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandCopyNetworkInfo}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.PingGatewayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{Binding DataContext.Actions.PingGatewayDisabledReason, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandPingGateway}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.FlushDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandFlushDns}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding DataContext.Actions.RenewIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="{Binding DataContext.Actions.RenewIpDisabledReason, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandRenewIp}"
                                        FontSize="12"
                                        HorizontalContentAlignment="Left" />
                            </UniformGrid>
                            <ProgressBar Height="3"
                                         Margin="0,4,0,8"
                                         IsIndeterminate="True"
                                         Visibility="{Binding DataContext.Actions.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Border AutomationProperties.LiveSetting="Assertive"
                            Visibility="{Binding DataContext.Actions.HasStatusMessage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}"
                            Style="{StaticResource ResultBannerStyle}"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding DataContext.Actions.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextWrapping="Wrap"
                                       Margin="28,0,0,0" />
                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DataContext.Actions.ClearStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="{x:Static res:Strings.CommandClearStatus}"
                                    ToolTip="{x:Static res:Strings.CommandClearStatus}">
                                <TextBlock Style="{StaticResource IconStyle}" Text="&#xE711;" />
                            </Button>
                            <TextBlock HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
                                        <Setter Property="Text" Value="&#xE946;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Success}">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Warning}">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Error}">
                                                <Setter Property="Text" Value="&#xE783;" />
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IconStyle}" Text="&#xE968;" Margin="0,0,10,0" />
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding ApplicationName}" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding ApplicationTagline}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="HistoryButton"
                            Margin="0,0,8,0"
                            Command="{Binding ToggleHistoryCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="{x:Static res:Strings.NotificationHistory}"
                            ToolTip="{x:Static res:Strings.NotificationHistory}">
                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xE7F4;" />
                    </Button>
                    <Button ToolTip="{x:Static res:Strings.SettingsTitle}"
                            Click="OnSettingsClicked"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="{x:Static res:Strings.SettingsTitle}">
                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xE713;" />
                    </Button>
                    <Popup IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=HistoryButton}"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           StaysOpen="False">
                        <Border Width="410"
                                MaxHeight="360"
                                Margin="0,8,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0"
                                        Content="{x:Static res:Strings.NotificationHistoryClear}"
                                        Command="{Binding ClearHistoryCommand}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Text="{x:Static res:Strings.NotificationHistory}" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{x:Static res:Strings.NotificationHistoryEmpty}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationHistory.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox BorderThickness="0"
                                         Background="{DynamicResource TransparentBrush}"
                                         ItemsSource="{Binding NotificationHistory}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ConnectedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:t}}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Text}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0"
                Height="28">
            <Grid DataContext="{Binding StatusBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource StatusBarTextStyle}" Text="{Binding ApplicationState}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding SelectedAdapterState}"
                           Margin="12,0,16,0" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding LastRefresh}"
                           Margin="12,0,16,0" />
                <TextBlock Grid.Column="3"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding AdministratorState}"
                           Margin="12,0,16,0" />
                <TextBlock Grid.Column="4"
                           Margin="12,0,16,0"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding Version}" />
                <Border Width="1"
                        Height="16"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="1" />
                <Border Width="1"
                        Height="16"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="2" />
                <Border Width="1"
                        Height="16"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="3" />
                <Border Width="1"
                        Height="16"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="4" />
            </Grid>
        </Border>
        <!-- Main content -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Inline refresh failure: never modal, never clears the last valid state. -->
            <StackPanel Grid.Row="0" Grid.Column="2">
                <Border Margin="20,12,20,0"
                        Padding="12,8"
                        Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasRefreshError, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding RefreshErrorText}"
                               TextWrapping="Wrap" />
                </Border>
                <Border Margin="20,12,20,0"
                        Padding="8,4"
                        Background="{DynamicResource ErrorBackgroundBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding SettingsWarningVisible, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Foreground="{DynamicResource ErrorTextBrush}"
                               Text="{Binding SettingsWarningText}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <Border x:Name="ProfilePanelRoot"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    VerticalAlignment="Stretch"
                    DataContext="{Binding ProfilePanel}"
                    CornerRadius="0"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{x:Static res:Strings.ProfilePanelHeader}" />
                        <Grid Margin="0,0,0,12">
                            <TextBox Margin="0"
                                     AutomationProperties.Name="{x:Static res:Strings.ProfileSearchPlaceholder}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{x:Static res:Strings.ProfileSearchPlaceholder}" />
                            <TextBlock Text="{x:Static res:Strings.ProfileSearchPlaceholder}"
                                       Margin="10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,16" />
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.ProfileSaveHeader}" />
                        <TextBox Margin="0,8,0,4"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}"
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static res:Strings.ProfileNameLabel}" />
                        <TextBox Margin="0,0,0,4"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileDescriptionLabel}"
                                 Text="{Binding NewProfileDescription, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static res:Strings.ProfileDescriptionLabel}" />
                        <CheckBox Margin="0,0,0,4"
                                  Content="{x:Static res:Strings.ProfileUseDhcpLabel}"
                                  IsChecked="{Binding NewProfileUsesDhcp}" />
                        <UniformGrid Columns="2">
                            <Button Command="{Binding SaveCommand}"
                                    Content="{x:Static res:Strings.CommandSaveProfile}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    FontSize="12"
                                    Margin="0,8,6,0" />
                            <Button Margin="0,8,0,0"
                                    Command="{Binding ImportCommand}"
                                    Content="{x:Static res:Strings.CommandImportProfile}"
                                    FontSize="12" />
                        </UniformGrid>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <ListBox BorderThickness="0"
                                                     Background="{DynamicResource TransparentBrush}"
                                                     ItemsSource="{Binding Profiles}"
                                                     SelectedItem="{Binding DataContext.SelectedProfile, ElementName=ProfilePanelRoot}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Padding="24,2,0,2"
                                                                       Tag="{Binding DataContext, ElementName=ProfilePanelRoot}"
                                                                       PreviewMouseLeftButtonDown="OnProfileMouseDown"
                                                                       PreviewMouseLeftButtonUp="OnProfileMouseUp"
                                                                       Text="{Binding Name}"
                                                                       Background="{DynamicResource TransparentBrush}"
                                                                       ToolTip="{Binding Description}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Command="{Binding RenameCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandRenameProfile}" />
                                                                        <MenuItem Command="{Binding DuplicateCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandDuplicateProfile}" />
                                                                        <MenuItem Command="{Binding ToggleFavoriteCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandToggleFavorite}" />
                                                                        <MenuItem Command="{Binding ExportCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandExportProfile}" />
                                                                        <MenuItem Command="{Binding DeleteCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandDeleteProfile}" />
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>
                                                            <TextBlock HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       PreviewMouseLeftButtonDown="OnProfileMouseDown"
                                                                       PreviewMouseLeftButtonUp="OnProfileMouseUp"
                                                                       Tag="{Binding DataContext, ElementName=ProfilePanelRoot}"
                                                                       Background="{DynamicResource TransparentBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock"
                                                                           BasedOn="{StaticResource IconStyle}">
                                                                        <Setter Property="Text" Value="&#xE734;" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource SecondaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}"
                                                                                         Value="True">
                                                                                <Setter Property="Text" Value="&#xE735;" />
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource WarningBorderBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Command="{Binding RenameCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandRenameProfile}" />
                                                                        <MenuItem Command="{Binding DuplicateCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandDuplicateProfile}" />
                                                                        <MenuItem Command="{Binding ToggleFavoriteCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandToggleFavorite}" />
                                                                        <MenuItem Command="{Binding ExportCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandExportProfile}" />
                                                                        <MenuItem Command="{Binding DeleteCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                  Header="{x:Static res:Strings.CommandDeleteProfile}" />
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>
                                                            <Border CornerRadius="4"
                                                                    Padding="4,2"
                                                                    Margin="4,0,0,0"
                                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                                    Grid.Column="1">
                                                                <TextBlock FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="12"
                                                                           Text="{Binding Summary}"
                                                                           PreviewMouseLeftButtonDown="OnProfileMouseDown"
                                                                           PreviewMouseLeftButtonUp="OnProfileMouseUp"
                                                                           Tag="{Binding DataContext, ElementName=ProfilePanelRoot}"
                                                                           Background="{DynamicResource TransparentBrush}">
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                            <MenuItem Command="{Binding RenameCommand}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                      Header="{x:Static res:Strings.CommandRenameProfile}" />
                                                                            <MenuItem Command="{Binding DuplicateCommand}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                      Header="{x:Static res:Strings.CommandDuplicateProfile}" />
                                                                            <MenuItem Command="{Binding ToggleFavoriteCommand}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                      Header="{x:Static res:Strings.CommandToggleFavorite}" />
                                                                            <MenuItem Command="{Binding ExportCommand}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                      Header="{x:Static res:Strings.CommandExportProfile}" />
                                                                            <MenuItem Command="{Binding DeleteCommand}"
                                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                                      Header="{x:Static res:Strings.CommandDeleteProfile}" />
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Margin="0,8,0,0"
                                      Header="{Binding ProblemsHeader}"
                                      Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Problems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding FileName, Mode=OneWay}" />
                                                <Run Text="{x:Static res:Strings.ProfileProblemSeparator}" />
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <StackPanel Margin="8,32" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource IconStyle}"
                                           Text="&#xE8B7;"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="{x:Static res:Strings.ProfileEmptyTitle}"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static res:Strings.ProfileEmptyDescription}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <TabControl Grid.Row="1"
                        Grid.Column="2"
                        IsEnabled="{Binding AreAdapterTabsEnabled}"
                        Background="{DynamicResource TransparentBrush}"
                        BorderThickness="0"
                        ItemsSource="{Binding Adapters}"
                        SelectedItem="{Binding SelectedAdapter}"
                        ItemTemplate="{StaticResource AdapterTabHeaderTemplate}"
                        ContentTemplate="{StaticResource AdapterTabContentTemplate}"
                        Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibility}}" />
            <!-- Loading -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{x:Static res:Strings.LoadingAdapters}" />
            </StackPanel>
            <!-- Empty -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource IconStyle}"
                           Text="&#xE968;"
                           FontSize="64"
                           Foreground="{DynamicResource DisconnectedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{x:Static res:Strings.EmptyStateTitle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{x:Static res:Strings.EmptyStateDescription}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
