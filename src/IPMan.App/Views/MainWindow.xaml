<Window x:Class="IPMan.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:vm="clr-namespace:IPMan.App.ViewModels"
        Title="{Binding ApplicationName}"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Tab header: name plus a shape-based connection marker, never colour alone. -->
        <DataTemplate x:Key="AdapterTabHeaderTemplate" DataType="{x:Type vm:AdapterViewModel}">
            <StackPanel Orientation="Horizontal"
                        AutomationProperties.Name="{Binding AccessibleDescription}"
                        ToolTip="{Binding AccessibleDescription}">
                <TextBlock Text="{Binding ConnectionMarker}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DisconnectedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ConnectedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayName}"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="DraftIpv4DifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsIpv4AddressDifferentFromWindows}" Value="True"><Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DraftSubnetDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSubnetMaskDifferentFromWindows}" Value="True"><Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DraftGatewayDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsGatewayDifferentFromWindows}" Value="True"><Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DraftPrimaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsPrimaryDnsDifferentFromWindows}" Value="True"><Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DraftSecondaryDnsDifferentStyle" TargetType="TextBox" BasedOn="{StaticResource DraftTextBoxStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSecondaryDnsDifferentFromWindows}" Value="True"><Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" /></DataTrigger></Style.Triggers>
        </Style>

        <!-- Tab content: current configuration on the left, editable draft on the right. -->
        <DataTemplate x:Key="AdapterTabContentTemplate" DataType="{x:Type vm:AdapterViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="330" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Current configuration (read-only) -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel DataContext="{Binding Details}">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                       Text="{x:Static res:Strings.CurrentConfigurationHeader}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConnectionState}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConnectionState}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdapterName}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Name}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldDescription}" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Description}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldMacAddress}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding MacAddress}" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldConfigurationMode}" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding ConfigurationMode}" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldIpv4Address}" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Ipv4Address}" />

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSubnetMask}" />
                                <TextBlock Grid.Row="6" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding SubnetMask}" />

                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldGateway}" />
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding Gateway}" />

                                <TextBlock Grid.Row="8" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldPrimaryDns}" />
                                <TextBlock Grid.Row="8" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding PrimaryDns}" />

                                <TextBlock Grid.Row="9" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSecondaryDns}" />
                                <TextBlock Grid.Row="9" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding SecondaryDns}" />

                                <TextBlock Grid.Row="10" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldLinkSpeed}" />
                                <TextBlock Grid.Row="10" Grid.Column="1"
                                           Style="{StaticResource FieldValueStyle}"
                                           Text="{Binding LinkSpeed}" />

                                <TextBlock Grid.Row="11" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldAdditionalIpv4Addresses}"
                                           Visibility="{Binding HasAdditionalIpv4Addresses,
                                                                Converter={StaticResource BooleanToVisibility}}" />
                                <ItemsControl Grid.Row="11" Grid.Column="1"
                                              Margin="0,0,0,6"
                                              ItemsSource="{Binding AdditionalIpv4AddressList}"
                                              Visibility="{Binding HasAdditionalIpv4Addresses,
                                                                   Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Configuration draft (edit only; nothing is written to Windows) -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel DataContext="{Binding Draft}">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                       Text="{x:Static res:Strings.DraftConfigurationHeader}" />

                            <TextBlock Margin="0,0,0,14"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{x:Static res:Strings.DraftConfigurationHint}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding ProfileGuidance}"
                                       TextWrapping="Wrap" />

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Actions.IsBusy,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldIpv4Address}" />
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBox x:Name="Ipv4AddressBox"
                                             Style="{StaticResource DraftIpv4DifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}"
                                             Text="{Binding Ipv4Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding Ipv4AddressError}" />
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.Ipv4Address}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldIpv4Address}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSubnetMask}" />
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox Style="{StaticResource DraftSubnetDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}"
                                             Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding SubnetMaskError}" />
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.SubnetMask}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSubnetMask}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldGateway}" />
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBox Style="{StaticResource DraftGatewayDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldGateway}"
                                             Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding GatewayError}" />
                                </StackPanel>
                                <Button Grid.Row="2" Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.Gateway}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldGateway}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldPrimaryDns}" />
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <TextBox Style="{StaticResource DraftPrimaryDnsDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}"
                                             Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding PrimaryDnsError}" />
                                </StackPanel>
                                <Button Grid.Row="3" Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.PrimaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldPrimaryDns}" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{x:Static res:Strings.FieldSecondaryDns}" />
                                <StackPanel Grid.Row="4" Grid.Column="1">
                                    <TextBox Style="{StaticResource DraftSecondaryDnsDifferentStyle}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}"
                                             Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldErrorTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding SecondaryDnsError}" />
                                </StackPanel>
                                <Button Grid.Row="4" Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyFieldCommand}"
                                        CommandParameter="{x:Static vm:DraftField.SecondaryDns}"
                                        Content="{x:Static res:Strings.CommandCopy}"
                                        AutomationProperties.Name="{x:Static res:Strings.FieldSecondaryDns}" />
                            </Grid>

                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyStaticCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandApply}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.ApplyDhcpCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandUseDhcp}" />
                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DataContext.Actions.RestoreLastCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="{x:Static res:Strings.CommandRestoreLast}" />
                                <Button Command="{Binding GetCurrentValuesCommand}"
                                        Content="{x:Static res:Strings.CommandGetCurrentValues}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Actions.IsBusy,
                                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <ProgressBar Height="3"
                                         Margin="0,4,0,8"
                                         IsIndeterminate="True"
                                         Visibility="{Binding DataContext.Actions.IsBusy,
                                                              RelativeSource={RelativeSource AncestorType=Window},
                                                              Converter={StaticResource BooleanToVisibility}}" />

                            <Border Padding="12,8"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Visibility="{Binding DataContext.Actions.HasStatusMessage,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BooleanToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Success}">
                                                <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Information}">
                                                <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Warning}">
                                                <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Actions.StatusSeverity,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:ApplyStatusSeverity.Error}">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding DataContext.Actions.StatusMessage,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding ApplicationName}" />
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding ApplicationTagline}" />
                </StackPanel>
                <Button Grid.Column="1" Content="⚙" FontSize="18" Padding="8,2"
                        ToolTip="{x:Static res:Strings.SettingsTitle}" Click="OnSettingsClicked" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6">
            <Grid DataContext="{Binding StatusBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding ApplicationState}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding SelectedAdapterState}" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding LastRefresh}" />
                <TextBlock Grid.Column="3"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding AdministratorState}" />
                <TextBlock Grid.Column="4"
                           Margin="0"
                           Style="{StaticResource StatusBarTextStyle}"
                           Text="{Binding Version}" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ProfilePanelRoot"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    VerticalAlignment="Stretch"
                    DataContext="{Binding ProfilePanel}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{x:Static res:Strings.ProfilePanelHeader}" />
                        <TextBox Margin="0,0,0,8"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileSearchPlaceholder}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,0,0,10"
                                Command="{Binding ImportCommand}"
                                Content="{x:Static res:Strings.CommandImportProfile}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBox Margin="0,8,0,4"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileNameLabel}"
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,0,0,4"
                                 AutomationProperties.Name="{x:Static res:Strings.ProfileDescriptionLabel}"
                                 Text="{Binding NewProfileDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="0,0,0,4"
                                  Content="{x:Static res:Strings.ProfileUseDhcpLabel}"
                                  IsChecked="{Binding NewProfileUsesDhcp}" />
                        <Button Command="{Binding SaveCommand}"
                                Content="{x:Static res:Strings.CommandSaveProfile}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibility}}" />
                        <Expander Margin="0,8,0,0"
                                  Header="{Binding ProblemsHeader}"
                                  Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding FileName}" />
                                            <Run Text="{x:Static res:Strings.ProfileProblemSeparator}" />
                                                <Run Text="{Binding Reason}" />
                                            </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <ListBox BorderThickness="0"
                                                 Background="Transparent"
                                                 ItemsSource="{Binding Profiles}"
                                                 SelectedItem="{Binding DataContext.SelectedProfile, ElementName=ProfilePanelRoot}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                            <TextBlock Padding="4"
                                                       Tag="{Binding DataContext, ElementName=ProfilePanelRoot}"
                                                       PreviewMouseLeftButtonDown="OnProfileMouseDown"
                                                       PreviewMouseLeftButtonUp="OnProfileMouseUp"
                                                       Text="{Binding Name}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Command="{Binding RenameCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                  Header="{x:Static res:Strings.CommandRenameProfile}" />
                                                        <MenuItem Command="{Binding DuplicateCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                  Header="{x:Static res:Strings.CommandDuplicateProfile}" />
                                                        <MenuItem Command="{Binding ToggleFavoriteCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                  Header="{x:Static res:Strings.CommandToggleFavorite}" />
                                                        <MenuItem Command="{Binding ExportCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                  Header="{x:Static res:Strings.CommandExportProfile}" />
                                                        <MenuItem Command="{Binding DeleteCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                  Header="{x:Static res:Strings.CommandDeleteProfile}" />
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Inline refresh failure: never modal, never clears the last valid state. -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasRefreshError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding RefreshErrorText}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Margin="0,52,0,0" Padding="8,4"
                    Background="#FDECEC" Visibility="{Binding SettingsWarningVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="#B00020" Text="{Binding SettingsWarningText}" TextWrapping="Wrap" />
            </Border>

            <TabControl Grid.Row="1"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Adapters}"
                        SelectedItem="{Binding SelectedAdapter}"
                        ItemTemplate="{StaticResource AdapterTabHeaderTemplate}"
                        ContentTemplate="{StaticResource AdapterTabContentTemplate}"
                        Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibility}}" />

            <!-- Loading -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{x:Static res:Strings.LoadingAdapters}" />
            </StackPanel>

            <!-- Empty -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{x:Static res:Strings.EmptyStateTitle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{x:Static res:Strings.EmptyStateDescription}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
