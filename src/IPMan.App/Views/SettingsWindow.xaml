<Window x:Class="IPMan.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="480" Height="570" MinWidth="480" MinHeight="570"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <Border Background="#FDECEC" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding PersistenceWarning, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Foreground="#B00020" TextWrapping="Wrap" Text="{Binding PersistenceWarningText}" />
            </Border>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.SettingsTheme}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                <RadioButton Content="{x:Static res:Strings.SettingsThemeLight}" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                <RadioButton Content="{x:Static res:Strings.SettingsThemeDark}" IsEnabled="False" Margin="18,0,0,0" ToolTip="{x:Static res:Strings.SettingsThemeSoon}" />
                <RadioButton Content="{x:Static res:Strings.SettingsThemeSystem}" IsEnabled="False" Margin="18,0,0,0" ToolTip="{x:Static res:Strings.SettingsThemeSoon}" />
                <TextBlock Text="ⓘ" Margin="8,0,0,0" ToolTip="{x:Static res:Strings.SettingsHelpTheme}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.SettingsCloseBehavior}" />
            <StackPanel Margin="0,4,0,14">
                <RadioButton x:Name="AskRadioButton" Content="{x:Static res:Strings.SettingsCloseAsk}" Checked="OnCloseBehaviorChecked" Tag="Ask" />
                <RadioButton x:Name="TrayRadioButton" Content="{x:Static res:Strings.SettingsCloseTray}" Checked="OnCloseBehaviorChecked" Tag="Tray" />
                <RadioButton x:Name="ExitRadioButton" Content="{x:Static res:Strings.SettingsCloseExit}" Checked="OnCloseBehaviorChecked" Tag="Exit" />
                <TextBlock Text="ⓘ" ToolTip="{x:Static res:Strings.SettingsHelpClose}" />
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.SettingsNotifications}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,6" />
            <TextBlock Text="ⓘ" ToolTip="{x:Static res:Strings.SettingsHelpNotifications}" Margin="0,0,0,12" />
            <CheckBox Content="{x:Static res:Strings.SettingsApplyOnSelection}" IsChecked="{Binding ApplyProfileOnSelection}" Margin="0,0,0,6" />
            <TextBlock Text="ⓘ" ToolTip="{x:Static res:Strings.SettingsHelpApplyOnSelection}" Margin="0,0,0,12" />
            <CheckBox Content="{x:Static res:Strings.SettingsShowVirtual}" IsChecked="{Binding ShowVirtualAdapters}" Margin="0,0,0,6" />
            <TextBlock Text="ⓘ" ToolTip="{x:Static res:Strings.SettingsHelpShowVirtual}" Margin="0,0,0,12" />
            <CheckBox Content="{x:Static res:Strings.SettingsRememberWindow}" IsChecked="{Binding RememberWindowState}" Margin="0,0,0,6" />
            <TextBlock Text="ⓘ" ToolTip="{x:Static res:Strings.SettingsHelpRememberWindow}" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.SettingsReset}" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static res:Strings.CommandOk}" Click="OnCloseClicked" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
