<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.SettingsWindow"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="560"
        Height="720"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:motion="clr-namespace:IPMan.App.Presentation"
        motion:FluentMotion.Entrance="True"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel>
        <Border Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.SettingsDiagnostics}"
                        Command="{Binding OpenDiagnosticsCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Content="{x:Static res:Strings.SettingsReset}"
                        Command="{Binding ResetToDefaultsCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryActionButtonStyle}" />
                <Button Content="{x:Static res:Strings.CommandOk}"
                        Click="OnCloseClicked"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <Border Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,0,12"
                        Height="64"
                        motion:FluentMotion.Entrance="True"
                        Visibility="{Binding PersistenceWarning, Converter={StaticResource BooleanToHidden}}"
                        CornerRadius="8">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding PersistenceWarningText}" />
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.SettingsTheme}" />
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <RadioButton Content="{x:Static res:Strings.SettingsThemeLight}"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                         Margin="0,4,20,4" />
                            <RadioButton Content="{x:Static res:Strings.SettingsThemeDark}"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                         Margin="0,4,20,4" />
                            <RadioButton Content="{x:Static res:Strings.SettingsThemeSystem}"
                                         IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                         Margin="0,4,20,4" />
                            <TextBlock Text="&#xE946;"
                                       Margin="8,0,0,0"
                                       ToolTip="{x:Static res:Strings.SettingsHelpTheme}"
                                       Style="{StaticResource IconStyle}"
                                       FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{x:Static res:Strings.SettingsCloseBehavior}" />
                        <StackPanel Margin="0">
                            <RadioButton x:Name="AskRadioButton"
                                         Content="{x:Static res:Strings.SettingsCloseAsk}"
                                         Checked="OnCloseBehaviorChecked"
                                         Tag="Ask" />
                            <RadioButton x:Name="TrayRadioButton"
                                         Content="{x:Static res:Strings.SettingsCloseTray}"
                                         Checked="OnCloseBehaviorChecked"
                                         Tag="Tray" />
                            <RadioButton x:Name="ExitRadioButton"
                                         Content="{x:Static res:Strings.SettingsCloseExit}"
                                         Checked="OnCloseBehaviorChecked"
                                         Tag="Exit" />
                            <TextBlock Text="&#xE946;"
                                       ToolTip="{x:Static res:Strings.SettingsHelpClose}"
                                       Style="{StaticResource IconStyle}"
                                       FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{x:Static res:Strings.SettingsNotifications}" />
                        <StackPanel Margin="0">
                            <RadioButton Content="{x:Static res:Strings.SettingsNotificationsDisabled}"
                                         IsChecked="{Binding IsNotificationModeDisabled, Mode=TwoWay}" />
                            <RadioButton Content="{x:Static res:Strings.SettingsNotificationsWhenUnfocused}"
                                         IsChecked="{Binding IsNotificationModeWhenUnfocused, Mode=TwoWay}" />
                            <RadioButton Content="{x:Static res:Strings.SettingsNotificationsAlways}"
                                         IsChecked="{Binding IsNotificationModeAlways, Mode=TwoWay}" />
                            <TextBlock Text="&#xE946;"
                                       ToolTip="{x:Static res:Strings.SettingsHelpNotifications}"
                                       Style="{StaticResource IconStyle}"
                                       FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <CheckBox Content="{x:Static res:Strings.SettingsApplyOnSelection}"
                                  IsChecked="{Binding ApplyProfileOnSelection}"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="&#xE946;"
                                   ToolTip="{x:Static res:Strings.SettingsHelpApplyOnSelection}"
                                   Margin="0,0,0,12"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="14" />
                        <CheckBox Content="{x:Static res:Strings.SettingsShowVirtual}"
                                  IsChecked="{Binding ShowVirtualAdapters}"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="&#xE946;"
                                   ToolTip="{x:Static res:Strings.SettingsHelpShowVirtual}"
                                   Margin="0,0,0,12"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="14" />
                        <CheckBox Content="{x:Static res:Strings.SettingsRememberWindow}"
                                  IsChecked="{Binding RememberWindowState}"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="&#xE946;"
                                   ToolTip="{x:Static res:Strings.SettingsHelpRememberWindow}"
                                   Margin="0,0,0,16"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
