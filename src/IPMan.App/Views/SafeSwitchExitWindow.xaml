<Window x:Class="IPMan.App.Views.SafeSwitchExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        Title="{x:Static res:Strings.SafeSwitchExitTitle}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}">
    <DockPanel><StackPanel Margin="24">
        <TextBlock Text="{x:Static res:Strings.SafeSwitchExitQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,24" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.SafeSwitchCancel}" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.SafeSwitchExitRevert}" Click="OnRevert" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.SafeSwitchExitKeep}" Click="OnKeep" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" />
        </WrapPanel>
    </StackPanel></DockPanel>
</Window>
