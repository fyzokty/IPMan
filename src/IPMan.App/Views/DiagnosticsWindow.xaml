<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.DiagnosticsWindow"
        Title="{x:Static res:Strings.DiagnosticsTitle}"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="320"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="OnLoaded"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.DiagnosticsRefresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="{x:Static res:Strings.CommandCopy}"
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="{x:Static res:Strings.CommandOk}"
                        Click="OnCloseClicked"
                        IsCancel="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0" />
            </StackPanel>
        </Border>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CopyStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CopyStatus}" Value="{x:Static res:Strings.DiagnosticsCopyFailed}">
                                <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding CopyStatus}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{x:Static res:Strings.DiagnosticsTitle}">
                    <ItemsControl ItemsSource="{Binding ReportRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, Mode=OneWay}"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 TextAlignment="Right"
                                                 Background="{DynamicResource TransparentBrush}"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 MinHeight="0"
                                                 AutomationProperties.Name="{Binding Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
