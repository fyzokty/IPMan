<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IPMan.App.Views.DiagnosticsWindow"
        Title="{x:Static res:Strings.DiagnosticsTitle}"
        Width="760"
        SizeToContent="Height"
        MaxHeight="720"
        MinWidth="620"
        MinHeight="320"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="OnLoaded"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        xmlns:motion="clr-namespace:IPMan.App.Presentation"
        motion:FluentMotion.Entrance="True"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.DiagnosticsRefresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="{x:Static res:Strings.CommandCopy}"
                        Command="{Binding CopyCommand}"
                        motion:CopyFeedback.IsEnabled="True"
                        motion:CopyFeedback.Result="{Binding CopySucceeded}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="{x:Static res:Strings.CommandOk}"
                        Click="OnCloseClicked"
                        IsCancel="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0" />
            </StackPanel>
                <TextBlock Text="{Binding CopyStatus}" VerticalAlignment="Center" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CopyStatus}"
                           AutomationProperties.LiveSetting="Polite" motion:FluentMotion.Entrance="True">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CopyStatus}" Value="{x:Static res:Strings.DiagnosticsCopyFailed}">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
        <Grid Margin="16">
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{x:Static res:Strings.DiagnosticsTitle}">
                    <ItemsControl ItemsSource="{Binding ReportRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, Mode=OneWay}"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 TextAlignment="Right"
                                                 Background="{DynamicResource TransparentBrush}"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 MinHeight="0"
                                                 AutomationProperties.Name="{Binding Name}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
