<Window x:Class="IPMan.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:IPMan.App.Resources"
        Title="{x:Static res:Strings.DiagnosticsTitle}"
        Width="620" Height="440" MinWidth="480" MinHeight="320"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="OnLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"
                 AutomationProperties.Name="{x:Static res:Strings.DiagnosticsTitle}" />
        <TextBlock Grid.Row="1" Text="{Binding CopyStatus}" TextWrapping="Wrap" Margin="0,10,0,10"
                   Foreground="{DynamicResource PrimaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.DiagnosticsRefresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="14,6" />
            <Button Content="{x:Static res:Strings.CommandCopy}" Command="{Binding CopyCommand}" Margin="0,0,8,0" Padding="14,6" />
            <Button Content="{x:Static res:Strings.CommandOk}" Click="OnCloseClicked" IsCancel="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
