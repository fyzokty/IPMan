<Application x:Class="IPMan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <sys:Double x:Key="FieldMaxWidth">340</sys:Double>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E1E1" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D5D5D" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#107C10" />
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#8A8886" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4CE" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#E9C46A" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#A80000" />
        <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#DFF6DD" />
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#107C10" />
        <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EFF6FC" />
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#0F6CBD" />
        <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
        <SolidColorBrush x:Key="ErrorBorderBrush" Color="#A80000" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DraftTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MaxWidth" Value="{StaticResource FieldMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="FieldErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="{StaticResource FieldMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,-4,8,8" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Application.Resources>
</Application>
