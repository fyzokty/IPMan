<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A4D63" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#454545" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ConnectedBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#4A3B00" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0C85A" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB4AB" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#173E1D" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#173B55" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#4B2020" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FFB4AB" />
</ResourceDictionary>
